{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "World Clock",
  "version": "1.0.0",
  "identifier": "dev.omarchy.worldclock",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5183",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "World Clock",
        "width": 380,
        "height": 640,
        "minWidth": 300,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "center": true,
        "maxWidth": 560,
        "maxHeight": 900
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Elsewhen's world clock, as a desktop widget",
    "longDescription": "A world clock that sits on the desktop: every city's local time, daylight and sunrise, a globe to spin, and Omarchy's themes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
